# Telegram
BOT_TOKEN=
BOT_USERNAME=
OWNER_TG_ID=            # the only Telegram user allowed to use the app
PUBLIC_URL=             # https address of the mini app

# LLM for parsing voice/text/screenshots: anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_DAILY_CAP=

# Speech-to-text: openai | groq | telethon (Telegram Premium transcription)
STT_PROVIDER=openai
STT_API_KEY=
STT_API_KEY_GROQ=
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_SESSION=

# Storage
DB_PATH=./data/finuchet.db
BACKUP_DIR=./data/backups
TMP_DIR=./data/tmp

# Optional
MASHREQ_PDF_PASSWORD=   # to read password-protected bank statements
REMIND_ENABLED=1
NO_BOT=0                # 1 = run API + mini app without the bot
